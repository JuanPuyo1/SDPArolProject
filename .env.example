# Orchestrator Backend: 'langgraph' (default multi-agent) | 'stub' (CI / single-agent fallback)
ORCHESTRATOR_BACKEND=langgraph

# LLM Provider Selection: 'anthropic' (default) | 'ollama' | 'local' | 'openai_compatible'
LLM_PROVIDER=anthropic

# Anthropic Claude Configuration (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Local / Ollama Configuration (used when LLM_PROVIDER=ollama or local)
# Examples: gemma4:latest, qwen2.5:3b, llama3.2:3b
LOCAL_LLM_MODEL=gemma4:latest
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_TEMPERATURE=0.0
LOCAL_LLM_TIMEOUT=60.0

# Qdrant Vector DB (RAG)
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION_MANUALS=arol_manuals_fastembed
QDRANT_COLLECTION_ERROR_CODES=arol_error_codes

# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SDP Project
